{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEO-EDU",
  "version": "0.1.0",
  "identifier": "vn.neoedu.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:static",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "./out"
  },
  "app": {
    "windows": [
      {
        "title": "NEO-EDU - Nền tảng Học tập Thông minh",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null,
      "nsis": {
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "release": "1"
      }
    },
    "category": "Education",
    "shortDescription": "Nền tảng học tập trực tuyến thông minh",
    "longDescription": "NEO-EDU là nền tảng giáo dục trực tuyến với AI Tutor, gamification và spaced repetition giúp học sinh ôn thi hiệu quả.",
    "publisher": "NEO-EDU Team",
    "copyright": "© 2026 NEO-EDU. All rights reserved.",
    "licenseFile": "LICENSE"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": {
      "all": true
    },
    "clipboard": {
      "all": true
    }
  }
}
